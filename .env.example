# Environment variables for Code Breakers Judge.
# Copy to .env.local and change every value before the event.
# NEVER put this file in a shared folder, USB handout or git repo.

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars

# Default contest duration in minutes (admin can change at runtime).
CONTEST_DURATION_MINUTES=45

# Number of rounds for the event (1-10). The admin can change this live on the
# dashboard. Teams are shortlisted on the leaderboard between rounds.
TOTAL_ROUNDS=3

# Languages offered to teams, comma separated.
# Allowed: python, c, cpp, java, javascript
ALLOWED_LANGUAGES=python,c,cpp,java,javascript

# Resource limits for submitted code.
# MEMORY_LIMIT_MB caps address space on Linux (C/C++/Python) and the V8 heap for
# JavaScript; Java uses JAVA_MAX_HEAP_MB. Set to 0 to disable.
# On Windows, C/C++/Python have no portable memory cap (wall-clock only).
MEMORY_LIMIT_MB=512
JAVA_MAX_HEAP_MB=256

# Cooldown between a team's actions, in milliseconds.
# SUBMIT_COOLDOWN_MS is between hidden-test submissions.
# RUN_COOLDOWN_MS is between "Run samples" clicks (runs share the judge queue).
SUBMIT_COOLDOWN_MS=15000
RUN_COOLDOWN_MS=3000

# How many submissions/runs are judged at once on the server PC.
JUDGE_CONCURRENCY=3

# Port the app listens on.
PORT=3000

# Optional proctoring. Set to 1 to block paste into the code editor.
# Tab switches and paste attempts are always logged for the admin.
NEXT_PUBLIC_BLOCK_PASTE=0
